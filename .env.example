# DeepSearch Agents 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY

# RAGFlow 配置（已下线，保留仅用于回滚旧链路；新链路使用下方自研 RAG 配置）
RAGFLOW_API_URL=http://your-ragflow-host
RAGFLOW_API_KEY=ragflow-your-api-key

# ─── 自研 RAG 配置（app/rag，全部有默认值，不填即可运行） ───
# 知识库数据根目录，每个知识库是其中一个子目录（默认项目根下的 rag_data/）
# RAG_DATA_DIR=rag_data
# 默认知识库名称（仓库自带的示例库叫 fin，想直接试可用 fin）
# RAG_DEFAULT_KB=fin
#
# ⚠️ 向量后端三选一，**选了就要与知识库的建库后端一致**：
#   hash   —— 离线兜底（无需任何模型），仓库自带的 rag_data/fin 就是用它建的，开箱即用
#   local  —— 本地 BGE 中文模型，语义效果最好；需先 `uv sync --extra local-embedding` 装依赖
#   openai —— 走 OpenAI 兼容的 /embeddings 接口
#   换后端后必须重新入库，否则会因向量指纹不一致被 EmbeddingMismatchError 拦下
#   （这是有意的保护：不同模型的向量空间不可比，混用只会得到无意义结果）。
#   重新入库：python -m app.rag.cli reset -k fin --yes && python -m app.rag.cli ingest -k fin -p docs/knowledge_base
# RAG_EMBEDDING_PROVIDER=hash
# RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 本地模型推理设备：auto / cpu / cuda
# RAG_EMBEDDING_DEVICE=auto
# hash 兜底与接口后端的向量维度
# RAG_EMBEDDING_DIM=512

# ── 向量存储后端（向量"存在哪"）────────────────────────────
# numpy —— 默认：全量内存 + 磁盘持久化（rag_data/<kb>/vectors.npy），零依赖，万级规模毫秒级
# qdrant —— Qdrant 本地嵌入模式（默认，数据落 rag_data/<kb>/qdrant/）或远程 server
#   换后端必须重新入库（不同后端不自动迁移）。
#   本地模式安装：uv pip install qdrant-client   （1.13+ 已内置本地引擎，无需 [local] extra）
#   远程模式：RAG_QDRANT_URL=http://localhost:6333（先 docker 起 qdrant/qdrant），只装 qdrant-client 即可
# RAG_VECTORSTORE=numpy
# RAG_QDRANT_URL=
# 切块参数：单个片段字符数与相邻片段重叠字符数（中文建议 400~600）
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=80
# 粗排候选数 / 精排后送入大模型的条数
# RAG_TOP_K=10
# RAG_TOP_N=4
# 重排模式：lexical(本地词面重排，零成本，默认) / llm(大模型列表式重排，更准更慢) / off(不重排)
# RAG_RERANK_MODE=lexical
# RRF 融合平滑常数
# RAG_RRF_K=60
# 相似度阈值：低于该值判定「知识库无依据」直接拒答，避免模型编造。
# 注意它比较的是**向量余弦**，所以换向量后端后必须重新标定（hash 与 BGE 的分数分布不同）
# 同时也被用作「低分重试」的阈值（见下方 RAG_QUERY_REWRITE）
# RAG_MIN_SCORE=0.2
#
# ─── 查询改写（Query Rewrite：解决"查询过短/口语化/用词与文档不一致"）───
# off      关闭（与引入改写之前的行为完全一致）
# local    只用本地规则（口语归一化 + 同义词扩展 + 专有名词/数字强化），零成本（**应用默认**）
# llm      只用大模型改写；不可用/超时/返回异常时自动降级为 local
# local+llm 两级都用（本地变体 + 大模型变体合并）
# RAG_QUERY_REWRITE=local
# 变体总数上限（含原始查询——原始查询永远保留，只增不减召回）
# RAG_QUERY_VARIANTS=3
# 首轮判定分（向量余弦）低于 RAG_MIN_SCORE 时，是否自动用改写变体重试一次
# RAG_RETRY_ON_LOW_SCORE=true
# 补充同义词表：key=扩展词1|扩展词2;key2=扩展词（内置词表见 app/rag/rewrite.py）
# RAG_REWRITE_SYNONYMS=客诉=投诉|工单投诉;拉新=获客
# ⚠️ 大模型改写（llm / local+llm）用的是推理型模型时，必须给足 token 预算：
#    推理过程先吃掉 completion tokens，预算不够会返回空 content（实测 max_tokens=400 必空）。
#    代码已按 LLM_MAX_TOKENS=1500 调用；预算不足时按"返回无法解析"降级为本地改写，不会阻断检索。
# 对比实验入口（同一份语料同一个问题）：
#   python -m app.rag.cli search -k rewrite_demo -q "成交比例" --no-rewrite
#   python -m app.rag.cli search -k rewrite_demo -q "成交比例"
#   python -m app.rag.cli search -k rewrite_demo -q "成交比例" --rewrite-always
#   python -m app.rag.cli eval   -k rewrite_demo -e examples/rag_eval_set_rewrite.json --no-rewrite

# ─── 缓存（embedding / 查询结果 / 生成结果）───
# 默认关闭：查询与生成缓存一旦陈旧就是"返回过期答案"，不该由默认配置承担这个风险。
# 缓存文件落在 rag_data/<kb>/.cache/（已在 .gitignore 里排除）；知识库有任何 chunk 增删改
# （数据版本号 +1）或执行 reset 时，该库缓存整体失效。
# RAG_CACHE_ENABLED=false
# 开启后的用法（同一问题第二次会命中缓存，结果里标 [缓存] 且 cached=true）：
#   python -m app.rag.cli search -k rewrite_demo -q "成交比例" --cache
#   python -m app.rag.cli search -k rewrite_demo -q "成交比例" --cache   # 第二次命中
#
# ─── 审计日志（JSONL，每次 search/query 一条，不含原文）───
# 默认开启。记录：时间戳/查询/过滤条件/改写变体/是否命中缓存/是否低分重试/结果摘要
# （chunk_id+source+分数+通道，不含正文）/是否调用大模型与耗时/拒答原因/向量指纹。
# 写入失败（目录不可写等）只 warning，绝不影响查询。
# RAG_AUDIT_ENABLED=true
# 审计目录；留空 = 跟随 RAG_DATA_DIR 下的 .audit/（默认即 rag_data/.audit/）
# RAG_AUDIT_DIR=
# 查看：python -m app.rag.cli audit -k rewrite_demo --tail 20

# ─── OCR（图片 / 扫描件兜底；方案 A：默认走 Windows 内置引擎，零 pip 依赖）───
# 作用：图片文件（.png/.jpg/.jpeg/.bmp/.webp/.tif/.tiff）直接 OCR 成文本；
#       PDF 里**文本层过少**的页（扫描件/整页图片）自动对该页做 OCR 兜底。
# 默认开启，但只影响「文本层取不到内容」的页 —— 有文本层的页面**不会**被 OCR 覆盖
#（否则就是用更差的识别结果替换干净原文，是净损失）。
# 后端不可用/未安装时自动降级为 none 并 warning，**不影响入库**（OCR 是兜底，不是主路径）。
# RAG_OCR_ENABLED=true
# 后端：windows（系统内置 Windows.Media.Ocr，仅 Windows）/ rapidocr（需装 rapidocr-onnxruntime）/ none
# RAG_OCR_BACKEND=windows
# PDF 单页文本层字符数低于该值时对该页做 OCR（0 = 关闭页级 OCR）
# RAG_OCR_MIN_TEXT_CHARS=50
# OCR 语言（BCP-47）；Windows 需已安装对应语言包，否则引擎创建失败并降级
# RAG_OCR_LANGUAGE=zh-Hans-CN
# ⚠️ OCR 是兜底，不要当成默认路径：真实 PDF 封面页实测「文本层 113 字符 vs OCR 55 字符」，#    且 OCR 会丢字/错字（`2026`→`6`、页脚乱码）。质量实测见 docs/rag-ocr.md
# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# docs/docker-compose.yaml 建议映射到 3307，避免和本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# ─── 企业级升级配置(均有安全默认值,不填即可运行) ───
# 长期记忆数据库路径(SQLite 文件;可换成 postgresql://... 连接串)
# MEMORY_DB_PATH=app/data/memory.db
# 记忆召回条数上限
# MEMORY_RECALL_LIMIT=5
# 上下文 Token 预算(超过则裁剪历史)
# CONTEXT_MAX_TOKENS=30000
# 上下文重放的历史消息条数上限
# CONTEXT_HISTORY_MESSAGES=40
# 开启鉴权后必须携带 Authorization: Bearer <AUTH_API_KEY>
# AUTH_ENABLED=false
# AUTH_API_KEY=
# 全局并发任务上限
# MAX_CONCURRENT_TASKS=8
# 每 IP 每分钟请求数上限
# RATE_LIMIT_PER_MINUTE=60
# 日志级别/格式(DEBUG|INFO|WARNING|ERROR / text|json)
# LOG_LEVEL=INFO
# LOG_FORMAT=text
