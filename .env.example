# DeepSearch Agents 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY

# RAGFlow 配置（已下线，保留仅用于回滚旧链路；新链路使用下方自研 RAG 配置）
RAGFLOW_API_URL=http://your-ragflow-host
RAGFLOW_API_KEY=ragflow-your-api-key

# ─── 自研 RAG 配置（app/rag，全部有默认值，不填即可运行） ───
# 知识库数据根目录，每个知识库是其中一个子目录（默认项目根下的 rag_data/）
# RAG_DATA_DIR=rag_data
# 默认知识库名称
# RAG_DEFAULT_KB=default
# 向量化后端：local(本地 BGE 模型，中文效果最好) / openai(接口向量) / hash(离线兜底，无模型可用)
# RAG_EMBEDDING_PROVIDER=local
# RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 本地模型推理设备：auto / cpu / cuda
# RAG_EMBEDDING_DEVICE=auto
# hash 兜底与接口后端的向量维度
# RAG_EMBEDDING_DIM=512
# 切块参数：单个片段字符数与相邻片段重叠字符数（中文建议 400~600）
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=80
# 粗排候选数 / 精排后送入大模型的条数
# RAG_TOP_K=10
# RAG_TOP_N=4
# 重排模式：lexical(本地词面重排，零成本，默认) / llm(大模型列表式重排，更准更慢) / off(不重排)
# RAG_RERANK_MODE=lexical
# RRF 融合平滑常数
# RAG_RRF_K=60
# 相似度阈值：低于该值判定「知识库无依据」直接拒答，避免模型编造
# RAG_MIN_SCORE=0.2
# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# docs/docker-compose.yaml 建议映射到 3307，避免和本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# ─── 企业级升级配置(均有安全默认值,不填即可运行) ───
# 长期记忆数据库路径(SQLite 文件;可换成 postgresql://... 连接串)
# MEMORY_DB_PATH=app/data/memory.db
# 记忆召回条数上限
# MEMORY_RECALL_LIMIT=5
# 上下文 Token 预算(超过则裁剪历史)
# CONTEXT_MAX_TOKENS=30000
# 上下文重放的历史消息条数上限
# CONTEXT_HISTORY_MESSAGES=40
# 开启鉴权后必须携带 Authorization: Bearer <AUTH_API_KEY>
# AUTH_ENABLED=false
# AUTH_API_KEY=
# 全局并发任务上限
# MAX_CONCURRENT_TASKS=8
# 每 IP 每分钟请求数上限
# RATE_LIMIT_PER_MINUTE=60
# 日志级别/格式(DEBUG|INFO|WARNING|ERROR / text|json)
# LOG_LEVEL=INFO
# LOG_FORMAT=text
